{
  "name": "figtx",
  "productName": "FigTX",
  "version": "0.2.0",
  "private": true,
  "description": "论文图表 LaTeX 样式库 —— 表格与图的样式可视化浏览、检索与复用",
  "author": "ZhipingWoods",
  "license": "Apache-2.0",
  "type": "module",
  "main": "electron/main.cjs",
  "homepage": "https://github.com/ZhipingWoods/FigTX",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZhipingWoods/FigTX.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "node tools/build-data.mjs && vite build && node tools/fix-html.mjs",
    "preview": "vite preview --port 4173",
    "electron:dev": "npm run build && electron .",
    "electron:serve": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER=http://localhost:5173 electron .\"",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:all": "npm run build && electron-builder -mwl",
    "data": "node tools/build-data.mjs",
    "check:dups": "node tools/check-dups.mjs",
    "offline": "npm run build && node tools/make-offline.mjs",
    "figgen": ".venv-fig/bin/python tools/figgen/cli.py",
    "figgen:contracts": ".venv-fig/bin/python tools/figgen/build_contracts.py",
    "figgen:serve": ".venv-fig/bin/python tools/figgen/server.py",
    "skills:install": "bash scripts/install-skills.sh",
    "forge:test": "uv run --project packages/figtx-forge pytest packages/figtx-forge/tests -q",
    "sync": "uv run --with pillow --with numpy --with pyyaml --with huggingface_hub python -m tools.sync.run",
    "sync:test": "uv run --with pytest --with pillow --with numpy --with pyyaml --with huggingface_hub pytest tools/sync/tests -q",
    "test:web": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.65.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.2.7",
    "wait-on": "^8.0.1"
  }
}
